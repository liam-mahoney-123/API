import json
import random
from datetime import datetime

class User:
    def __init__(self, user_id, name, email):
        self.user_id = user_id
        self.name = name
        self.email = email
        self.projects = []

    def add_project(self, project):
        self.projects.append(project)

    def to_dict(self):
        return {
            "id": self.user_id,
            "name": self.name,
            "email": self.email,
            "projects": [project.to_dict() for project in self.projects]
        }

class Project:
    def __init__(self, project_id, name, created_at):
        self.project_id = project_id
        self.name = name
        self.created_at = created_at

    def to_dict(self):
        return {
            "id": self.project_id,
            "name": self.name,
            "created_at": self.created_at.isoformat()
        }

def fetch_user_data():
    # Simulate fetching user data from a database
    user = User(
        user_id=random.randint(1000, 9999),
        name="Jane Doe",
        email="jane.doe@example.com"
    )
    # Simulate adding projects
    for i in range(3):
        project = Project(
            project_id=random.randint(100, 999),
            name=f"Project {chr(65+i)}",
            created_at=datetime.now()
        )
        user.add_project(project)
    return user

def export_user_data_to_json(user, filename="exported_user_data.json"):
    with open(filename, "w") as f:
        json.dump(user.to_dict(), f, indent=4)
    print(f"User data exported to {filename}")

if __name__ == "__main__":
    user = fetch_user_data()
    export_user_data_to_json(user)
